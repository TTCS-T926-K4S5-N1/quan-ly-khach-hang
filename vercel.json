{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/dashboard.html" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/customers", "destination": "/frontend/customers.html" },
    { "source": "/customer-360", "destination": "/frontend/customer-360.html" },
    { "source": "/pipeline", "destination": "/frontend/pipeline.html" },
    { "source": "/pipeline-settings", "destination": "/frontend/pipeline-settings.html" },
    { "source": "/quotations", "destination": "/frontend/quotations.html" },
    { "source": "/contracts", "destination": "/frontend/contracts.html" },
    { "source": "/lead-forms", "destination": "/frontend/lead-forms.html" },
    { "source": "/lead-routing", "destination": "/frontend/lead-routing.html" },
    { "source": "/campaigns", "destination": "/frontend/campaigns.html" },
    { "source": "/activities", "destination": "/frontend/activities.html" },
    { "source": "/calendar", "destination": "/frontend/calendar.html" },
    { "source": "/tasks", "destination": "/frontend/tasks.html" },
    { "source": "/sales-targets", "destination": "/frontend/sales-targets.html" },
    { "source": "/email-marketing", "destination": "/frontend/email-marketing.html" },
    { "source": "/automation-rules", "destination": "/frontend/automation-rules.html" },
    { "source": "/products", "destination": "/frontend/products.html" },
    { "source": "/users", "destination": "/frontend/users.html" },
    { "source": "/organization", "destination": "/frontend/organization.html" },
    { "source": "/custom-fields", "destination": "/frontend/custom-fields.html" },
    { "source": "/master-data", "destination": "/frontend/master-data.html" },
    { "source": "/audit-log", "destination": "/frontend/audit-log.html" },
    { "source": "/profile", "destination": "/frontend/profile.html" },
    { "source": "/crm/(.*)", "destination": "/frontend/$1" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
